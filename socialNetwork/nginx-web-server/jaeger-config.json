{
  "service_name": "nginx-web-server",
  "disabled": false,
  "reporter": {
    "logSpans": false,
    "localAgentHostPort": "jaeger-agent.social-network.svc.cluster.local:6831",
    "queueSize": 1000000,
    "bufferFlushInterval": 10
  },
  "sampler": {
    "type": "probabilistic",
    "param": 0.2
  }
}