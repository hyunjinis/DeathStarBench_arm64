  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "social-network"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "namespace": "social-network",
        "name": "jaeger"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "name": "jaeger"
          }
        },
        "template": {
          "metadata": {
            "name": "jaeger",
            "labels": {
              "name": "jaeger"
            }
          },
          "spec": {
            "nodeSelector": {
              "group": "exp"
            },
            "containers": [
              {
                "name": "jaeger",
                "image": "jaegertracing/all-in-one:latest@sha256:30238ffd383f266651cd4e0c36be67b6b0d3d882d0bbb67304c39af9ee61a4ef",
                "env": [
                  {
                    "name": "COLLECTOR_ZIPKIN_HTTP_PORT",
                    "value": "9411"
                  }
                ]
              }
            ],
            "restartPolicy": "Always",
            "enableServiceLinks": false
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "namespace": "social-network",
        "name": "jaeger"
      },
      "spec": {
        "type": "NodePort",
        "ports": [
          {
            "name": "16686",
            "port": 16686,
            "nodePort": 30005
          },
          {
            "name": "9411",
            "port": 9411
          }
        ],
        "selector": {
          "name": "jaeger"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "namespace": "social-network",
        "name": "nginx-thrift"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "name": "nginx-thrift"
          }
        },
        "template": {
          "metadata": {
            "name": "nginx-thrift",
            "labels": {
              "name": "nginx-thrift"
            }
          },
          "spec": {
            "nodeSelector": {
              "kubernetes.io/hostname": "rpi2-desktop"
            },
            "tolerations": [
              {
                "key": "node-role.kubernetes.io/control-plane",
                "operator": "Exists",
                "effect": "NoSchedule"
              }
            ],
            "containers": [
              {
                "name": "nginx-thrift",
                "image": "hyunjinis/openresty-thrift-arm64",
                "volumeMounts": [
                  {
                    "name": "nginx-conf",
                    "mountPath": "/usr/local/openresty/nginx/conf/nginx.conf",
                    "subPath": "nginx.conf"
                  },
                  {
                    "name": "nginx-conf",
                    "mountPath": "/usr/local/openresty/nginx/jaeger-config.json",
                    "subPath": "jaeger-config.json"
                  },
                  {
                    "name": "nginx-lua-thrift",
                    "mountPath": "/usr/local/openresty/lualib/thrift"
                  },
                  {
                    "name": "nginx-pages",
                    "mountPath": "/usr/local/openresty/nginx/pages"
                  },
                  {
                    "name": "lua-scripts",
                    "mountPath": "/usr/local/openresty/nginx/lua-scripts"
                  },
                  {
                    "name": "nginx-gen-lua",
                    "mountPath": "/gen-lua"
                  }
                ],
                "env": [
                  {
                    "name": "fqdn_suffix",
                    "value": ".social-network.svc.cluster.local"
                  }
                ]
              }
            ],
            "restartPolicy": "Always",
            "enableServiceLinks": false,
            "volumes": [
              {
                "name": "nginx-conf",
                "configMap": {
                  "name": "nginx-thrift-conf"
                }
              },
              {
                "name": "nginx-lua-thrift",
                "configMap": {
                  "name": "nginx-thrift-lua-thrift"
                }
              },
              {
                "name": "lua-scripts",
                "hostPath": {
                  "path": "/home/rpi2/DeathStarBench/socialNetwork/nginx-web-server/lua-scripts",
                  "type": "Directory"
                }
              },
              {
                "name": "nginx-pages",
                "hostPath": {
                  "path": "/home/rpi2/DeathStarBench/socialNetwork/nginx-web-server/pages",
                  "type": "Directory"
                }
              },
              {
                "name": "nginx-gen-lua",
                "configMap": {
                  "name": "nginx-thrift-gen-lua"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "namespace": "social-network",
        "name": "nginx-thrift"
      },
      "spec": {
        "type": "NodePort",
        "ports": [
          {
            "port": 8080,
            "targetPort": 8080,
            "nodePort": 30001
          }
        ],
        "selector": {
          "name": "nginx-thrift"
        }
      }
    },
